# BWEB MIME Types
AddType application/x-bweb .bweb
AddType application/x-bml .bml

<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # 1. Wenn der Request-Header "X-BWEB-Native" gesetzt ist: Direkt ausliefern
    RewriteCond %{HTTP:X-BWEB-Native} true
    RewriteRule ^ - [L]

    # 2. raw=true nur von eigenem Referer akzeptieren (Polyfill-Fetch)
    RewriteCond %{QUERY_STRING} (^|&)raw=true(&|$)
    RewriteCond %{HTTP_REFERER} ^https?://(www\.)?mediclean-pro\.at/ [NC,OR]
    RewriteCond %{HTTP_REFERER} ^https?://localhost [NC]
    RewriteRule ^ - [L]

    # 3. raw=true ohne gültigen Referer → blockieren
    RewriteCond %{QUERY_STRING} (^|&)raw=true(&|$)
    RewriteRule ^ - [F,L]

    # 4. Für BWEB-Dateien, die direkt aufgerufen werden:
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^(.*)\.(bweb|bml|bdt|blb|bib)$ polyfill.html?file=$1.$2 [QSA,L]
</IfModule>

# CORS auf eigene Domain beschränken
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "https://mediclean-pro.at"
    Header set Access-Control-Allow-Methods "GET, OPTIONS"
    Header set Access-Control-Allow-Headers "Content-Type, X-BWEB-Native"
</IfModule>

# Kompression für HTML/CSS/JS (BWEB hat eigene Kompression)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript
</IfModule>

# Cache für Binary Assets (1 Jahr)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType application/x-bweb "access plus 1 year"
    ExpiresByType application/x-bml "access plus 1 year"
</IfModule>
