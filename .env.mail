# Email Configuration
# You can define multiple sender profiles here.
# Format: MAIL_PROFILE_<name>_USER and MAIL_PROFILE_<name>_PASS
# The default profile is used if no source matches.

# Default Profile (Microsoft 365)
MAIL_DEFAULT_SERVER=smtp.office365.com
MAIL_DEFAULT_PORT=587
MAIL_DEFAULT_USER=info@mediclean-pro.at
MAIL_DEFAULT_PASS=your_password_here

# Podcast Pro Profile
MAIL_PODCAST_SERVER=smtp.office365.com
MAIL_PODCAST_PORT=587
MAIL_PODCAST_USER=podcast@mediclean-pro.at
MAIL_PODCAST_PASS=your_podcast_password_here
