{
  "manifest_version": 3,
  "name": "BWEB Inspector & Privacy Companion",
  "version": "1.0.0",
  "description": "Inspektiere binäre BWEB-Seiten, analysiere die cookie-freie Architektur und entdecke die Zukunft der Privatsphäre.",
  "permissions": [
    "tabs",
    "storage",
    "declarativeNetRequest"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*.bml*",
        "https://*/*.bml*",
        "http://*/*.bdt*",
        "https://*/*.bdt*",
        "http://*/*.blb*",
        "https://*/*.blb*",
        "http://*/*.bib*",
        "https://*/*.bib*",
        "http://*/*.bweb*",
        "https://*/*.bweb*",
        "file:///*/*.bml*",
        "file:///*/*.bdt*",
        "file:///*/*.blb*",
        "file:///*/*.bib*",
        "file:///*/*.bweb*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "bweb-inspector@mediclean-pro.at",
      "strict_min_version": "109.0"
    }
  }
}
