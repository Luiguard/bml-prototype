    "isText": true,
    "textContent": "body {\n            font-family: sans-serif;\n            margin: 0;\n            padding: 40px;\n            background-color: #f4f4f9;\n            color: #333;\n        }\n        .header {\n            text-align: center;\n            margin-bottom: 40px;\n        }\n        h1 {\n            font-size: 3rem;\n            margin-bottom: 10px;\n            color: #2c3e50;\n        }\n        p.subtitle {\n            font-size: 1.2rem;\n            color: #7f8c8d;\n        }\n        .cards {\n            display: flex;\n            gap: 20px;\n            justify-content: center;\n            flex-wrap: wrap;\n        }\n        .card {\n            background: #fff;\n            padding: 20px;\n            border-radius: 8px;\n            box-shadow: 0 4px 6px rgba(0,0,0,0.1);\n            width: 300px;\n            box-sizing: border-box;\n        }\n        .card h2 {\n            margin-top: 0;\n            color: #2980b9;\n        }\n        .card p {\n            line-height: 1.5;\n            color: #555;\n        }",
